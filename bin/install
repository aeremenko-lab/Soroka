#!/usr/bin/env bash
set -euo pipefail

# Soroka installer — runs ON the VPS, in the directory where the repo
# was cloned. Sets up Docker, writes .env, starts the container.
#
# Usage:
#   ssh user@vps                                                 # любым способом
#   git clone https://github.com/AndyShaman/soroka.git
#   cd soroka
#   ./bin/install
#
# Optional flags (skip prompts):
#   --tg-token <TOKEN>      Telegram bot token (от @BotFather)
#   --owner-id <ID>         Твой личный Telegram ID (от @userinfobot)

TG_TOKEN=""
OWNER_ID=""
TG_TOKEN_FROM_FLAG=0
OWNER_ID_FROM_FLAG=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --tg-token) TG_TOKEN="$2"; TG_TOKEN_FROM_FLAG=1; shift 2;;
    --owner-id) OWNER_ID="$2"; OWNER_ID_FROM_FLAG=1; shift 2;;
    *) echo "unknown flag: $1" >&2; exit 1;;
  esac
done

if [[ "$(uname -s)" != "Linux" ]]; then
  cat >&2 <<MSG

✗ bin/install запускается ПРЯМО НА VPS (Linux).

  Похоже, ты запустил его на своём Mac/Windows локально.
  Зайди сначала на сервер любым способом (ssh, web-консоль, PuTTY),
  и уже там:

    git clone https://github.com/AndyShaman/soroka.git
    cd soroka
    ./bin/install
MSG
  exit 1
fi

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_DIR"

# sudo prefix: пусто для root, sudo -n для passwordless. Иначе — фейл с подсказкой.
if [[ $EUID -eq 0 ]]; then
  SUDO=""
elif sudo -n true 2>/dev/null; then
  SUDO="sudo -n"
else
  cat >&2 <<MSG

✗ Нужен root или passwordless sudo на этом сервере.

  Варианты:
   • Зайти на VPS как root: ssh root@<host>
   • Или один раз настроить passwordless sudo текущему юзеру:
       echo "\$USER ALL=(ALL) NOPASSWD: ALL" | sudo tee /etc/sudoers.d/\$USER
       sudo chmod 440 /etc/sudoers.d/\$USER
MSG
  exit 1
fi

read_env_value() {
  local key="$1"
  [[ -f .env ]] || return 0
  awk -v key="$key" '
    $0 ~ "^[[:space:]]*(export[[:space:]]+)?" key "[[:space:]]*=" {
      sub("^[[:space:]]*(export[[:space:]]+)?", "", $0)
      sub("^[^=]*=[[:space:]]*", "", $0)
      sub(/\r$/, "", $0)
      if (($0 ~ /^".*"$/) || ($0 ~ /^\047.*\047$/)) {
        print substr($0, 2, length($0) - 2)
      } else {
        print $0
      }
      exit
    }
  ' .env
}

read_or_keep() {
  local var_name="$1" prompt="$2" mode="${3:-plain}"
  local current="${!var_name}"
  local value
  if [[ -n "$current" ]]; then
    if [[ "$mode" == "secret" ]]; then
      read -rp "$prompt [уже задан, Enter оставить]: " value
    else
      read -rp "$prompt [$current, Enter оставить]: " value
    fi
    if [[ -n "$value" ]]; then
      printf -v "$var_name" "%s" "$value"
    fi
  else
    read -rp "$prompt: " value
    printf -v "$var_name" "%s" "$value"
  fi
}

if [[ -f .env ]]; then
  echo "Найден существующий .env — сохраню уже заданные значения, если не заменить их в подсказках."
fi

if [[ -z "$TG_TOKEN" ]]; then
  TG_TOKEN="$(read_env_value TELEGRAM_BOT_TOKEN || true)"
fi
if [[ -z "$OWNER_ID" ]]; then
  OWNER_ID="$(read_env_value OWNER_TELEGRAM_ID || true)"
fi

SOROKA_JINA_API_KEY="$(read_env_value SOROKA_JINA_API_KEY || true)"
SOROKA_DEEPGRAM_API_KEY="$(read_env_value SOROKA_DEEPGRAM_API_KEY || true)"
SOROKA_GITHUB_REPO="$(read_env_value SOROKA_GITHUB_REPO || true)"
SOROKA_GITHUB_TOKEN="$(read_env_value SOROKA_GITHUB_TOKEN || true)"
SOROKA_LLM_MODEL="$(read_env_value SOROKA_LLM_MODEL || true)"
SOROKA_LLM_PROVIDER="$(read_env_value SOROKA_LLM_PROVIDER || true)"
SOROKA_OPENAI_API_KEY="$(read_env_value SOROKA_OPENAI_API_KEY || true)"
SOROKA_GEMINI_API_KEY="$(read_env_value SOROKA_GEMINI_API_KEY || true)"
SOROKA_OWNER_TZ="$(read_env_value SOROKA_OWNER_TZ || true)"
SOROKA_DB_PATH="$(read_env_value SOROKA_DB_PATH || true)"
SOROKA_VPS_USER="$(read_env_value SOROKA_VPS_USER || true)"
SOROKA_VPS_HOST="$(read_env_value SOROKA_VPS_HOST || true)"

echo "🐦 Soroka — installer"
echo
echo "Что я сейчас сделаю:"
echo "  • поставлю docker и docker compose (если ещё нет)"
echo "  • запишу .env в $REPO_DIR/.env"
echo "  • запущу контейнер soroka-bot"
echo "  • положу /usr/local/bin/soroka-mcp"
echo

echo "──────────────────────────────────────────────────────────────"
echo "1/2 → Токен Telegram-бота"
echo
echo "Получи у @BotFather: команда /newbot → длинная строка вида"
echo "  1234567:AAC××××××××××××××××××××××××××××××××××××"
echo
if (( TG_TOKEN_FROM_FLAG == 0 )); then
  read_or_keep TG_TOKEN "Токен бота" secret
fi

echo
echo "──────────────────────────────────────────────────────────────"
echo "2/2 → Твой Telegram-ID (число)"
echo
echo "Это ID твоего профиля. Узнай: напиши /start боту @userinfobot —"
echo "он пришлёт число вроде 123456789."
echo
if (( OWNER_ID_FROM_FLAG == 0 )); then
  read_or_keep OWNER_ID "Telegram-ID"
fi

if [[ -z "$TG_TOKEN" ]]; then
  echo "✗ TELEGRAM_BOT_TOKEN пустой. Укажите токен или оставьте существующий в .env." >&2
  exit 1
fi
if [[ -z "$OWNER_ID" ]]; then
  echo "✗ OWNER_TELEGRAM_ID пустой. Укажите Telegram-ID или оставьте существующий в .env." >&2
  exit 1
fi
if ! [[ "$OWNER_ID" =~ ^[0-9]+$ ]]; then
  echo "✗ OWNER_TELEGRAM_ID должен быть числом, получено: $OWNER_ID" >&2
  exit 1
fi

echo
echo "──────────────────────────────────────────────────────────────"
echo "→ Проверяю зависимости (что уже стоит — не трогаю)..."

NEED_DOCKER=0
NEED_COMPOSE=0
command -v docker >/dev/null 2>&1 || NEED_DOCKER=1
$SUDO docker compose version >/dev/null 2>&1 || NEED_COMPOSE=1

if (( NEED_DOCKER || NEED_COMPOSE )); then
  # Ждём, если apt сейчас занят (unattended-upgrades, daily timer и т.п.).
  # Не убиваем чужой процесс — просто терпеливо ждём.
  WAITED=0
  WARNED=0
  while $SUDO fuser /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock /var/cache/apt/archives/lock >/dev/null 2>&1; do
    if (( WARNED == 0 )); then
      echo "  apt сейчас занят другим процессом — жду до 15 минут..."
      $SUDO fuser -v /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/cache/apt/archives/lock 2>&1 | head -10 || true
      WARNED=1
    fi
    if (( WAITED >= 900 )); then
      echo "  ✗ apt всё ещё занят после 15 минут." >&2
      exit 1
    fi
    sleep 10
    WAITED=$((WAITED + 10))
  done

  export DEBIAN_FRONTEND=noninteractive
  $SUDO apt-get update -qq 2>&1 | grep -vE '^(W:|N:|Get:|Ign:|Hit:)' || true
fi

if (( NEED_DOCKER )); then
  echo "  ставлю docker.io (engine из основных репо Ubuntu)..."
  $SUDO apt-get install -y -qq docker.io
fi

if (( NEED_COMPOSE )); then
  # docker compose v2 нужен как plugin. В разных версиях Ubuntu пакет
  # называется по-разному. Чтобы не лезть в системные sources.list.d/ —
  # ставим один бинарник в штатное место для plugins.
  echo "  ставлю docker compose v2 (бинарник от Docker Inc.)..."
  ARCH=$(uname -m)
  case "$ARCH" in
    x86_64|aarch64) ;;
    *) echo "  ✗ архитектура $ARCH не поддерживается официальным релизом" >&2; exit 1;;
  esac
  $SUDO mkdir -p /usr/local/lib/docker/cli-plugins
  $SUDO curl -fsSL \
    "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-${ARCH}" \
    -o /usr/local/lib/docker/cli-plugins/docker-compose
  $SUDO chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
fi

# soroka-mcp вызывается по SSH под текущим юзером и делает `docker exec`
# без sudo. Если юзер не в группе docker — отказ на /var/run/docker.sock.
# Идемпотентно добавляем. Свежий SSH-коннект подхватит автоматически.
# root и так имеет доступ — пропускаем.
if [[ $EUID -ne 0 ]] && ! id -nG | grep -qw docker; then
  echo "  добавляю $(id -un) в группу docker (для soroka-mcp без sudo)..."
  $SUDO usermod -aG docker "$(id -un)"
fi
echo "  ✓ зависимости готовы"

echo "→ Записываю .env..."
{
  printf 'TELEGRAM_BOT_TOKEN=%s\n' "$TG_TOKEN"
  printf 'OWNER_TELEGRAM_ID=%s\n' "$OWNER_ID"
  [[ -n "$SOROKA_OWNER_TZ" ]] && printf 'SOROKA_OWNER_TZ=%s\n' "$SOROKA_OWNER_TZ"
  [[ -n "$SOROKA_DB_PATH" ]] && printf 'SOROKA_DB_PATH=%s\n' "$SOROKA_DB_PATH"
  [[ -n "$SOROKA_VPS_USER" ]] && printf 'SOROKA_VPS_USER=%s\n' "$SOROKA_VPS_USER"
  [[ -n "$SOROKA_VPS_HOST" ]] && printf 'SOROKA_VPS_HOST=%s\n' "$SOROKA_VPS_HOST"
  printf '\n'
  printf '# Filled by the /start wizard and /set* commands.\n'
  printf 'SOROKA_JINA_API_KEY=%s\n' "$SOROKA_JINA_API_KEY"
  printf 'SOROKA_DEEPGRAM_API_KEY=%s\n' "$SOROKA_DEEPGRAM_API_KEY"
  printf 'SOROKA_GITHUB_REPO=%s\n' "$SOROKA_GITHUB_REPO"
  printf 'SOROKA_GITHUB_TOKEN=%s\n' "$SOROKA_GITHUB_TOKEN"
  printf '\n'
  printf '# Optional LLM for URL summaries and search reranking.\n'
  printf '# Examples:\n'
  printf '# SOROKA_LLM_MODEL=openai:gpt-4.1-mini\n'
  printf '# SOROKA_LLM_MODEL=gemini:gemini-2.5-flash\n'
  [[ -n "$SOROKA_LLM_PROVIDER" ]] && printf 'SOROKA_LLM_PROVIDER=%s\n' "$SOROKA_LLM_PROVIDER"
  printf 'SOROKA_LLM_MODEL=%s\n' "$SOROKA_LLM_MODEL"
  printf 'SOROKA_OPENAI_API_KEY=%s\n' "$SOROKA_OPENAI_API_KEY"
  printf 'SOROKA_GEMINI_API_KEY=%s\n' "$SOROKA_GEMINI_API_KEY"
} | $SUDO tee .env >/dev/null
$SUDO chmod 600 .env

echo "→ Запускаю контейнер..."
$SUDO docker compose up -d --build

echo "→ Ставлю /usr/local/bin/soroka-mcp..."
$SUDO cp scripts/soroka-mcp /usr/local/bin/
$SUDO chmod +x /usr/local/bin/soroka-mcp

if $SUDO docker ps --format '{{.Names}}' | grep -q soroka-bot; then
  echo "  ✓ бот запущен"
fi

cat <<MSG

🎉 Готово!

Открой Telegram, найди своего бота и отправь /start.
Дальше всё настроишь в чате с ботом.

Обновлять бота:  cd $REPO_DIR && ./bin/update
MSG
